<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#E01B1B1B"
    android:padding="8dp"
    android:elevation="10dp">

    <!-- Compact bubble -->
    <LinearLayout
        android:id="@+id/compactView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/bubbleIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/presence_offline"
            android:contentDescription="Bubble" />

        <TextView
            android:id="@+id/bubbleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFF"
            android:textColor="#00FF9A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Expanded panel -->
    <LinearLayout
        android:id="@+id/expandedView"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Latency"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/bubbleLatency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="500" />

        <TextView
            android:id="@+id/bubbleLatencyValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 ms"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Packet Loss"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/bubbleLoss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50" />

        <TextView
            android:id="@+id/bubbleLossValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="%0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center" />

        <Button
            android:id="@+id/bubbleApply"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="Uygula / Toggle"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</LinearLayout>
