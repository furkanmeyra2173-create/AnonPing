<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AnonPing"
            android:textColor="#00FF9A"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Network Impairment Tool"
            android:textColor="#666666"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161616"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● IDLE"
                android:textColor="#888888"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161616"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="LATENCY" android:textColor="#00FF9A" android:textSize="11sp"
                android:textStyle="bold" android:letterSpacing="0.15" />

            <TextView android:id="@+id/tvLatencyValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="0 ms" android:textColor="#FFFFFF"
                android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <SeekBar android:id="@+id/seekLatency" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:progressTint="#00FF9A" android:thumbTint="#00FF9A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161616"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PACKET LOSS" android:textColor="#00FF9A" android:textSize="11sp"
                android:textStyle="bold" android:letterSpacing="0.15" />

            <TextView android:id="@+id/tvLossValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="%0" android:textColor="#FFFFFF"
                android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <SeekBar android:id="@+id/seekLoss" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:progressTint="#00FF9A" android:thumbTint="#00FF9A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161616"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="BANDWIDTH LIMIT" android:textColor="#00FF9A" android:textSize="11sp"
                android:textStyle="bold" android:letterSpacing="0.15" />

            <TextView android:id="@+id/tvBandwidthValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="∞ Unlimited" android:textColor="#FFFFFF"
                android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <SeekBar android:id="@+id/seekBandwidth" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:progressTint="#00FF9A" android:thumbTint="#00FF9A" />
        </LinearLayout>

        <Button android:id="@+id/btnStart" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="START VPN" android:textColor="#000000"
            android:textStyle="bold" android:backgroundTint="#00FF9A" android:layout_marginBottom="10dp" />

        <Button android:id="@+id/btnStop" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="STOP VPN" android:textColor="#00FF9A"
            android:textStyle="bold" android:backgroundTint="#1A1A1A" android:layout_marginBottom="10dp" />

        <Button android:id="@+id/btnBubble" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="FLOATING BUBBLE" android:textColor="#00FF9A"
            android:textStyle="bold" android:backgroundTint="#1A1A1A" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="UDP full path • TCP requires tun2socks" android:textColor="#444444"
            android:textSize="11sp" android:gravity="center" android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
