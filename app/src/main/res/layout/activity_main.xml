<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/pp_bg">
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ScrollView android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="20dp">
     <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/playping_logo" android:contentDescription="PlayPing icon"/>
     <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
      <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PlayPing" android:textColor="@color/pp_text" android:textSize="25sp" android:textStyle="bold"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NETWORK CONTROL" android:textColor="@color/pp_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12"/>
     </LinearLayout>
     <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● OFFLINE" android:textColor="@color/pp_muted" android:textSize="10sp" android:textStyle="bold" android:paddingHorizontal="10dp" android:paddingVertical="8dp" android:background="@drawable/bg_pp_status_idle"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_pp_hero" android:padding="20dp" android:layout_marginBottom="22dp">
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NETWORK LAB" android:textColor="#B8D6FF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.15"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Shape your connection." android:textColor="@color/pp_text" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tune latency, packet loss and bandwidth for a controlled network test." android:textColor="#C1D0E4" android:textSize="13sp" android:lineSpacingExtra="3dp" android:layout_marginTop="7dp"/>
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  LOCAL VPN SESSION" android:textColor="#D6E6FB" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Network effects" android:textColor="@color/pp_text" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_pp_card" android:padding="16dp" android:layout_marginBottom="12dp">
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="◷" android:textColor="@color/pp_blue_light" android:textSize="24sp" android:background="@drawable/bg_pp_icon_chip"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="11dp">
       <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Latency" android:textColor="@color/pp_text" android:textSize="15sp" android:textStyle="bold"/>
       <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Additional round-trip delay" android:textColor="@color/pp_muted" android:textSize="11sp"/>
      </LinearLayout>
      <TextView android:id="@+id/tvLatencyValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 ms" android:textColor="@color/pp_blue_light" android:textSize="19sp" android:textStyle="bold"/>
     </LinearLayout>
     <SeekBar android:id="@+id/seekLatency" android:layout_width="match_parent" android:layout_height="36dp" android:max="2000" android:progress="0" android:progressTint="@color/pp_blue" android:thumbTint="@color/pp_blue_light" android:layout_marginTop="8dp"/>
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0 ms" android:textColor="@color/pp_muted" android:textSize="10sp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2000 ms" android:textColor="@color/pp_muted" android:textSize="10sp"/>
     </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_pp_card" android:padding="16dp" android:layout_marginBottom="12dp">
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="％" android:textColor="#93D8FF" android:textSize="20sp" android:background="@drawable/bg_pp_icon_chip"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="11dp">
       <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Packet loss" android:textColor="@color/pp_text" android:textSize="15sp" android:textStyle="bold"/>
       <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Drop IP packets in the tunnel" android:textColor="@color/pp_muted" android:textSize="11sp"/>
      </LinearLayout>
      <TextView android:id="@+id/tvLossValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="@color/pp_blue_light" android:textSize="19sp" android:textStyle="bold"/>
     </LinearLayout>
     <SeekBar android:id="@+id/seekLoss" android:layout_width="match_parent" android:layout_height="36dp" android:max="100" android:progress="0" android:progressTint="@color/pp_blue" android:thumbTint="@color/pp_blue_light" android:layout_marginTop="8dp"/>
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0%" android:textColor="@color/pp_muted" android:textSize="10sp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="@color/pp_muted" android:textSize="10sp"/>
     </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_pp_card" android:padding="16dp" android:layout_marginBottom="18dp">
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="↕" android:textColor="#B5C7FF" android:textSize="24sp" android:background="@drawable/bg_pp_icon_chip"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="11dp">
       <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bandwidth limit" android:textColor="@color/pp_text" android:textSize="15sp" android:textStyle="bold"/>
       <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upload and download throughput" android:textColor="@color/pp_muted" android:textSize="11sp"/>
      </LinearLayout>
      <TextView android:id="@+id/tvBandwidthValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unlimited" android:textColor="@color/pp_blue_light" android:textSize="15sp" android:textStyle="bold"/>
     </LinearLayout>
     <SeekBar android:id="@+id/seekBandwidth" android:layout_width="match_parent" android:layout_height="36dp" android:max="200" android:progress="0" android:progressTint="@color/pp_blue" android:thumbTint="@color/pp_blue_light" android:layout_marginTop="8dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
     <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="Start VPN" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/bg_pp_primary" android:stateListAnimator="@null" android:layout_marginEnd="7dp"/>
     <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="Stop VPN" android:textAllCaps="false" android:textColor="@color/pp_text" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/bg_pp_secondary" android:stateListAnimator="@null" android:layout_marginStart="7dp"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Traffic is routed through the local VPN on this device." android:textColor="@color/pp_muted" android:textSize="11sp" android:gravity="center" android:padding="8dp"/>
   </LinearLayout>
  </ScrollView>
  <ScrollView android:id="@+id/pageEffects" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true" android:scrollbars="none">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Impair catalog" android:textColor="@color/pp_text" android:textSize="27sp" android:textStyle="bold" android:layout_marginTop="10dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quick profiles for common network test conditions." android:textColor="@color/pp_muted" android:textSize="13sp" android:layout_marginTop="5dp" android:layout_marginBottom="22dp"/>
    <LinearLayout android:id="@+id/presetClean" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_pp_card" android:padding="16dp" android:clickable="true" android:focusable="true" android:layout_marginBottom="12dp">
     <View android:layout_width="4dp" android:layout_height="46dp" android:background="@drawable/bg_pp_accent_bar"/>
     <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="13dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Clean connection" android:textColor="@color/pp_text" android:textSize="16sp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 ms delay • 0% loss • Unlimited" android:textColor="@color/pp_muted" android:textSize="12sp" android:layout_marginTop="4dp"/>
     </LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apply ›" android:textColor="@color/pp_blue_light" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/presetDelay" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_pp_card" android:padding="16dp" android:clickable="true" android:focusable="true" android:layout_marginBottom="12dp">
     <View android:layout_width="4dp" android:layout_height="46dp" android:background="@drawable/bg_pp_accent_bar"/>
     <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="13dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="High latency" android:textColor="@color/pp_text" android:textSize="16sp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="250 ms delay • 0% loss • Unlimited" android:textColor="@color/pp_muted" android:textSize="12sp" android:layout_marginTop="4dp"/>
     </LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apply ›" android:textColor="@color/pp_blue_light" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/presetUnstable" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_pp_card" android:padding="16dp" android:clickable="true" android:focusable="true" android:layout_marginBottom="12dp">
     <View android:layout_width="4dp" android:layout_height="46dp" android:background="@drawable/bg_pp_accent_bar"/>
     <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="13dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Unstable network" android:textColor="@color/pp_text" android:textSize="16sp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="150 ms delay • 8% loss • 1,000 KB/s" android:textColor="@color/pp_muted" android:textSize="12sp" android:layout_marginTop="4dp"/>
     </LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apply ›" android:textColor="@color/pp_blue_light" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/presetSevere" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_pp_card" android:padding="16dp" android:clickable="true" android:focusable="true" android:layout_marginBottom="20dp">
     <View android:layout_width="4dp" android:layout_height="46dp" android:background="@drawable/bg_pp_accent_bar"/>
     <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="13dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Severe disruption" android:textColor="@color/pp_text" android:textSize="16sp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="500 ms delay • 25% loss • 250 KB/s" android:textColor="@color/pp_muted" android:textSize="12sp" android:layout_marginTop="4dp"/>
     </LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apply ›" android:textColor="@color/pp_blue_light" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selecting a profile updates the controls. Start or re-apply VPN to activate its values." android:textColor="@color/pp_muted" android:textSize="11sp"/>
   </LinearLayout>
  </ScrollView>
  <ScrollView android:id="@+id/pageSettings" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true" android:scrollbars="none">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Settings" android:textColor="@color/pp_text" android:textSize="27sp" android:textStyle="bold" android:layout_marginTop="10dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manage floating controls and review the network engine." android:textColor="@color/pp_muted" android:textSize="13sp" android:layout_marginTop="5dp" android:layout_marginBottom="22dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_pp_card" android:padding="18dp" android:layout_marginBottom="13dp">
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Floating controls" android:textColor="@color/pp_text" android:textSize="16sp" android:textStyle="bold"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open a movable control bubble. Tap to toggle VPN; hold to open the controls." android:textColor="@color/pp_muted" android:textSize="12sp" android:lineSpacingExtra="3dp" android:layout_marginTop="6dp"/>
     <Button android:id="@+id/btnBubble" android:layout_width="match_parent" android:layout_height="52dp" android:text="Open floating controls" android:textAllCaps="false" android:textColor="@color/pp_text" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/bg_pp_secondary" android:stateListAnimator="@null" android:layout_marginTop="14dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_pp_card" android:padding="18dp" android:layout_marginBottom="13dp">
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Network engine" android:textColor="@color/pp_text" android:textSize="16sp" android:textStyle="bold"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Local VPN routing is powered by the AnonPing engine. Packet loss operates at the IP packet layer; bandwidth throttles forwarded traffic." android:textColor="@color/pp_muted" android:textSize="12sp" android:lineSpacingExtra="3dp" android:layout_marginTop="6dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_pp_card" android:padding="18dp">
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="About" android:textColor="@color/pp_text" android:textSize="16sp" android:textStyle="bold"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PlayPing UI • 0.3.0" android:textColor="@color/pp_muted" android:textSize="12sp" android:layout_marginTop="6dp"/>
    </LinearLayout>
   </LinearLayout>
  </ScrollView>
 </FrameLayout>
 <LinearLayout android:id="@+id/bottomNavigation" android:layout_width="match_parent" android:layout_height="74dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_pp_nav" android:paddingHorizontal="10dp" android:paddingVertical="5dp">
  <LinearLayout android:id="@+id/tabHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
   <ImageView android:id="@+id/iconTabHome" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_tab_home" android:tint="@color/pp_blue_light" android:contentDescription="Home"/>
   <TextView android:id="@+id/labelTabHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textColor="@color/pp_blue_light" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/tabEffects" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
   <ImageView android:id="@+id/iconTabEffects" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_tab_effects" android:tint="@color/pp_muted" android:contentDescription="Effects"/>
   <TextView android:id="@+id/labelTabEffects" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Effects" android:textColor="@color/pp_muted" android:textSize="10sp" android:layout_marginTop="4dp"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/tabSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
   <ImageView android:id="@+id/iconTabSettings" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_tab_settings" android:tint="@color/pp_muted" android:contentDescription="Settings"/>
   <TextView android:id="@+id/labelTabSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textColor="@color/pp_muted" android:textSize="10sp" android:layout_marginTop="4dp"/>
  </LinearLayout>
 </LinearLayout>
</LinearLayout>